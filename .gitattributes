# 改行コードの正規化: リポジトリ内は LF、作業ツリーは OS 設定に従う。
# ワークツリー/環境間で LF↔CRLF だけの差分ノイズが出るのを防ぐ。
* text=auto

# 生成物（ts-rs バインディング）は改行 LF 固定。gen:bindings が LF で書き出すため、
# 作業ツリーを CRLF にしないことで「改行だけの差分（見かけ上の M）」を消す。
src/bindings/** text eol=lf

# バイナリ（改行変換しない）
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.heic binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.mp4 binary
*.mov binary
*.zip binary
*.pdf binary
